# Tarayıcıda projenizin GitHub sayfasını açacak doğru ve eksiksiz kurumsal yöntem:
TARGET_URL="https://github.com/adalettekno/com.adalettekno.UdfArama"

if [ -f /.flatpak-info ]; then
    # Flatpak içindeyse, sandbox portalı üzerinden güvenli tetikleme
    flatpak-spawn --host xdg-open "$TARGET_URL"
else
    # Flatpak dışındaysa, sistemin kendi aracıyla tetikleme
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$TARGET_URL"
    else
        zenity --error --title="Hata" --text="Sistemde varsayılan tarayıcıyı tetikleyecek 'xdg-open' bulunamadı!" 2>/dev/null
        exit 1
    fi
fi
